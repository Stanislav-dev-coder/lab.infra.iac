entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt
        domains:
          - main: "*.{{ domain }}"

providers:
  file:
    filename: /etc/traefik/routes.yml

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ acme_email }}
      storage: /var/lib/traefik/acme.json
      caServer: {{ acme_server }}
      dnsChallenge:
        provider: timewebcloud
        resolvers:
          - 1.1.1.1:53
